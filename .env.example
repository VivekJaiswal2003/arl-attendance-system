DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Vercel Blob store token used for private worker document storage.
# Create a Blob store in the Vercel dashboard (Storage -> Blob) and copy its
# read/write token here. Required for the worker "Documents" upload feature.
BLOB_READ_WRITE_TOKEN="replace-with-your-vercel-blob-read-write-token"
